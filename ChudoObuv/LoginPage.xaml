<Page x:Class="ChudoObuv.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Вход в систему">
    <StackPanel Width="320" VerticalAlignment="Center">
        <Image Source="logo.png" Height="96" Margin="0,0,0,16" />
        <TextBlock Text="Вход в систему" FontSize="22" FontWeight="SemiBold"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Логин" Margin="0,16,0,4" />
        <TextBox x:Name="LoginTextBox" MaxLength="30"
                 ToolTip="Латинские буквы и цифры, пароль не требуется"
                 PreviewTextInput="LoginTextBox_PreviewTextInput" />
        <Button Content="Войти" Margin="0,16,0,0" Padding="0,6"
                IsDefault="True" Click="SignInButton_Click" />
        <Button Content="Продолжить как гость" Margin="0,8,0,0" Padding="0,6"
                Click="GuestButton_Click" />
    </StackPanel>
</Page>