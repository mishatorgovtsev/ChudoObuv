<Page x:Class="ChudoObuv.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Список заказов">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="Новый заказ" Padding="14,6" Click="NewOrderButton_Click" />
                <Button Content="Состав заказа" Padding="14,6" Margin="8,0,0,0"
                        Click="OpenButton_Click" />
                <Button Content="Удалить заказ" Padding="14,6" Margin="8,0,0,0"
                        Click="DeleteButton_Click" />
            </StackPanel>
            <TextBlock Margin="0,8,0,0" Foreground="Gray" TextWrapping="Wrap"
                       Text="Новый заказ: выберите товары в каталоге, нажмите «Заказ» и подтвердите его, указав клиента. Состав заказа также открывается двойным щелчком." />
        </StackPanel>

        <DataGrid x:Name="OrdersGrid" Grid.Row="1" Margin="0,12,0,0"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" HeadersVisibility="Column"
                  MouseDoubleClick="OrdersGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№ заказа" Binding="{Binding OrderId}" Width="90" />
                <DataGridTextColumn Header="Дата заказа"
                                    Binding="{Binding OrderDate, StringFormat='{}{0:dd.MM.yyyy}'}"
                                    Width="120" />
                <DataGridTextColumn Header="ФИО клиента" Binding="{Binding ClientName}" Width="*" />
                <DataGridTextColumn Header="Сумма"
                                    Binding="{Binding TotalAmount, StringFormat='{}{0:N0} ₽'}"
                                    Width="120" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>