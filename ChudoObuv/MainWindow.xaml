<Window x:Class="ChudoObuv.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь" Height="700" Width="1000" Icon="logo.ico">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8"
                BorderBrush="LightGray" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Content="← Назад" Padding="12,4"
                        Visibility="Collapsed" Click="BackButton_Click" />
                <TextBlock x:Name="PageTitleText" Grid.Column="1" FontSize="18"
                           FontWeight="SemiBold" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="UserNameText" Grid.Column="2" FontSize="14"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"
               Navigated="MainFrame_Navigated" />
    </DockPanel>
</Window>