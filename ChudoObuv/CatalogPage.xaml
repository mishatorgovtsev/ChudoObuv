<Page x:Class="ChudoObuv.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Каталог товаров">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>
    <ListBox x:Name="ProductsList"
             HorizontalContentAlignment="Stretch"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
                <Setter Property="Margin" Value="8,4" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
            <DataTemplate>
                <Border Background="{Binding RowBackground}"
                        BorderBrush="Gray" BorderThickness="1" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <Image Source="{Binding ImagePath}" Height="120" Stretch="Uniform" />
                        <StackPanel Grid.Column="1" Margin="12,0">
                            <TextBlock Text="{Binding Title}" FontSize="18"
                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Category}" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding QuantityText, StringFormat='Количество: {0}'}" />
                            <TextBlock Text="{Binding Composition}" FontSize="11"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding OldPrice, StringFormat='{}{0:N0} ₽'}"
                                       TextDecorations="Strikethrough" Foreground="Gray"
                                       Visibility="{Binding HasDiscount,
                                           Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding FinalPrice, StringFormat='{}{0:N0} ₽'}"
                                       FontSize="22" FontWeight="Bold" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</Page>