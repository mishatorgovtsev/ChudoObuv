<Page x:Class="ChudoObuv.OrderDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Состав заказа">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="OrderTitleText" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="ClientText" Margin="0,4,0,0" FontSize="14" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Дата заказа: " VerticalAlignment="Center" />
            <TextBlock x:Name="DateText" VerticalAlignment="Center" />
            <DatePicker x:Name="OrderDatePicker" Width="150" Visibility="Collapsed" />
            <Button x:Name="SaveDateButton" Content="Сохранить дату" Padding="12,3"
                    Margin="8,0,0,0" Visibility="Collapsed" Click="SaveDateButton_Click" />
        </StackPanel>

        <DataGrid x:Name="LinesGrid" Grid.Row="2" Margin="0,12,0,0"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товарная позиция" Binding="{Binding ProductTitle}" Width="*" />
                <DataGridTextColumn Header="Размер"
                                    Binding="{Binding SizeValue, StringFormat='{}{0:0.#}'}" Width="80" />
                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="100" />
                <DataGridTextColumn Header="Цена за пару"
                                    Binding="{Binding UnitPrice, StringFormat='{}{0:N0} ₽'}" Width="120" />
                <DataGridTextColumn Header="Сумма"
                                    Binding="{Binding Total, StringFormat='{}{0:N0} ₽'}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="TotalText" Grid.Row="3" FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Right" Margin="0,8" />

        <Button x:Name="DeleteLineButton" Grid.Row="4" Content="Удалить выбранную позицию"
                Padding="14,6" HorizontalAlignment="Left" Visibility="Collapsed"
                Click="DeleteLineButton_Click" />
    </Grid>
</Page>