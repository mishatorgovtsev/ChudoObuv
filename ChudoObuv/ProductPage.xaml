<Page x:Class="ChudoObuv.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Просмотр товара">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="ProductImage" Height="300" Stretch="Uniform"
                   VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="CategoryText" Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock x:Name="FinalPriceText" FontSize="24" FontWeight="Bold" />
                    <TextBlock x:Name="OldPriceText" Margin="10,0,0,3" Foreground="Gray"
                               TextDecorations="Strikethrough" VerticalAlignment="Bottom" />
                </StackPanel>
                <TextBlock Text="Состав" FontWeight="SemiBold" Margin="0,12,0,0" />
                <TextBlock x:Name="CompositionText" TextWrapping="Wrap" />
                <TextBlock Text="Описание" FontWeight="SemiBold" Margin="0,12,0,0" />
                <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" />
                <TextBlock x:Name="SizeRangeText" Margin="0,12,0,0" TextWrapping="Wrap" />

                <StackPanel x:Name="OrderPanel" Width="280" HorizontalAlignment="Left"
                            Margin="0,16,0,0">
                    <TextBlock Text="Доступные для заказа размеры" />
                    <ComboBox x:Name="SizeComboBox" DisplayMemberPath="DisplayText" />
                    <TextBlock Text="Количество пар" Margin="0,8,0,0" />
                    <TextBox x:Name="QuantityTextBox" Text="1" MaxLength="3"
                             PreviewTextInput="QuantityTextBox_PreviewTextInput" />
                    <Button Content="Добавить в заказ" Margin="0,12,0,0" Padding="0,6"
                            Click="AddToOrderButton_Click" />
                </StackPanel>
                <TextBlock x:Name="HintText" Foreground="Gray" Margin="0,16,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>